{
  "name": "@aio/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "AIO Space desktop shell (Electron). Linux first, Windows in Phase 6.",
  "main": "./out/main/index.js",
  "author": "AIO Space",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
